# Clave de Firecrawl (https://firecrawl.dev). Plan gratuito. NO actives recarga automática.
FIRECRAWL_API_KEY=
# Interruptor de la búsqueda en vivo. Ponlo en "false" (o bórralo) para apagarla del todo.
SEARCH_ENABLED=false
# Máximo de llamadas reales a Firecrawl por día y por instancia (1 crédito cada una). Por defecto 12.
SEARCH_DAILY_CAP=12
